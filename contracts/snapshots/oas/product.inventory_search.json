  "method": "POST",
  "path": "/product/202309/inventory/search",
  "operation": {
    "tags": [
      "product_v202309"
    ],
    "summary": "InventorySearch",
    "description": "Retrieve inventory information for multiple products or SKUs.\n**Note**: \n- Searches can be based on either product IDs or SKU IDs, not both at the same time.\n- Passing Product IDs returns the inventory information of all SKUs under the specified products.\n- Passing SKU IDs returns the inventory information for the specified SKUs.",
    "parameters": [
      {
        "name": "shop_cipher",
        "in": "query",
        "description": "Use this property to pass shop information in requesting the API. Failure in passing the correct value when requesting the API for cross-border shops will return incorrect response. ",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "x-tts-access-token",
        "in": "header",
        "description": "",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "Content-Type",
        "in": "header",
        "description": "Allowed type: application/json",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    ],
    "requestBody": {
      "content": {
        "application/json": {
          "schema": {
            "properties": {
              "product_ids": {
                "description": "A list of product IDs used to search for inventory information.\nMax IDs: 100",
                "example": [
                  "1729592969712207008"
                ],
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "sku_ids": {
                "description": "A list of SKU IDs used to search for inventory information.\nMax IDs: 600\n\n**Note**: If both `sku_ids` and `product_ids` are passed, `sku_ids` will take precedence.",
                "example": [
                  "1729388324987897824"
                ],
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Successful response",
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "code": {
                  "description": "The success or failure status code returned in API response.",
                  "format": "int32",
                  "type": "integer"
                },
                "data": {
                  "description": "Specific return information.",
                  "properties": {
                    "inventory": {
                      "description": "Inventory information for the requested products or SKUs.",
                      "items": {
                        "properties": {
                          "product_id": {
                            "description": "The ID of the requested product.",
                            "example": "1729592969712207008",
                            "type": "string"
                          },
                          "skus": {
                            "description": "The list of requested SKUs.",
                            "items": {
                              "properties": {
                                "id": {
                                  "description": "The SKU ID generated by TikTok Shop.",
                                  "example": "1729388324987897824",
                                  "type": "string"
                                },
                                "seller_sku": {
                                  "description": "An internal code/name for managing SKUs, not visible to buyers.",
                                  "example": "Color-Red-XM01",
                                  "type": "string"
                                },
                                "total_available_inventory_distribution": {
                                  "description": "The distribution of the total available inventory for the SKU across different channels.",
                                  "properties": {
                                    "campaign_inventory": {
                                      "description": "Inventory that is allocated to a specific campaign.",
                                      "items": {
                                        "properties": {
                                          "campaign_name": {
                                            "description": "The name of the associated campaign.",
                                            "example": "Big Sale",
                                            "type": "string"
                                          },
                                          "quantity": {
