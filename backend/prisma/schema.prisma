// TikTok Shop simulator schema (Phase 02 foundation).
// Later phases add models (orders, returns, conversations, coupons...) via NEW migrations only.
// Money is stored as integer VND (no minor units); amounts are never derived from totals.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShopStatus {
  ACTIVE
  SUSPENDED
}

enum TokenStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum WebhookJobStatus {
  PENDING
  IN_PROGRESS
  SUCCEEDED
  DEAD
}

enum WebhookAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
  LEASE_EXPIRED
}

enum DemoRole {
  SELLER
  BUYER
}

enum FaultTarget {
  API
  WEBHOOK
}

enum FaultKind {
  HTTP_ERROR
  DELAY
  DROP
  DUPLICATE
  // WEBHOOK only: the matching event is held back at enqueue time so later events overtake it.
  REORDER
  // API only, inventory update path: the request is dropped (connection closed, no response) BEFORE or AFTER the write is applied.
  TIMEOUT_BEFORE_WRITE
  TIMEOUT_AFTER_WRITE
  // API only, inventory update path: HTTP 200 with a non-zero envelope code; nothing is written.
  APP_ERROR_200
}

// Simulator-side identity. Never equal to SmartOmni tenant ids.
model Seller {
  id        String   @id @default(uuid())
  openId    String   @unique
  name      String
  email     String   @unique
  shops     Shop[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shop {
  id                String                @id @default(uuid())
  tiktokShopId      String                @unique
  shopCipher        String                @unique
  // Shop "code" and seller type as returned by Get Authorized Shops (code is simulator-generated; seller_type LOCAL for VN domestic shops, VN applicability unverified).
  code              String                @default("")
  sellerType        String                @default("LOCAL")
  name              String
  region            String                @default("VN")
  currency          String                @default("VND")
  status            ShopStatus            @default(ACTIVE)
  sellerId          String
  seller            Seller                @relation(fields: [sellerId], references: [id])
  activeScenarioId  String?
  buyers            Buyer[]
  warehouses        Warehouse[]
  products          Product[]
  scenarios         Scenario[]            @relation("ShopScenarios")
  tokens            Token[]
  authCodes         AuthorizationCode[]
  webhookJobs       WebhookJob[]
  orders            Order[]
  conversations     Conversation[]
  webhookSubs       WebhookSubscription[]
  packages          Package[]
  aftersaleRequests AftersaleRequest[]
  coupons           Coupon[]
  faultRules        FaultRule[]
  demoSessions      DemoSession[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([sellerId])
}

// Buyers belong to exactly one shop (separate buyer sets per shop).
model Buyer {
  id            String         @id @default(uuid())
  externalId    String         @unique
  shopId        String?
  shop          Shop?          @relation(fields: [shopId], references: [id])
  name          String
  email         String
  phone         String
  addressLine   String
  district      String
  city          String
  demoSessions  DemoSession[]
  orders        Order[]
  cartItems     CartItem[]
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([shopId])
}

// Third-party app (e.g. SmartOmni). appSecret is a FAKE dev value and is redacted in every log.
model App {
  id           String                @id @default(uuid())
  appKey       String                @unique
  appSecret    String
  name         String
  redirectUris String[]
  scopes       String[]
  tokens       Token[]
  authCodes    AuthorizationCode[]
  webhookSubs  WebhookSubscription[]
  webhookJobs  WebhookJob[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

// Tokens are stored as SHA-256 hashes; the raw value is only returned once by the issuing flow (Phase 03).
// accessExpiresAt/refreshExpiresAt are compared with the AuthClock (real time), never the business clock.
// `scopes` are the GRANTED scopes of this authorization (a Test Console action can remove one); they are not the app's scopes.
model Token {
  id               String      @id @default(uuid())
  appId            String
  app              App         @relation(fields: [appId], references: [id])
  shopId           String
  shop             Shop        @relation(fields: [shopId], references: [id])
  accessTokenHash  String      @unique
  refreshTokenHash String      @unique
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  scopes           String[]
  status           TokenStatus @default(ACTIVE)
  revokedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([shopId])
  @@index([appId])
}

// Short-lived, single-use authorization code issued after the seller accepts consent. Only the SHA-256 hash is stored.
model AuthorizationCode {
  id          String    @id @default(uuid())
  codeHash    String    @unique
  appId       String
  app         App       @relation(fields: [appId], references: [id])
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id])
  redirectUri String
  state       String?
  scopes      String[]
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([shopId])
  @@index([appId])
}

model Warehouse {
  id               String            @id @default(uuid())
  shopId           String
  shop             Shop              @relation(fields: [shopId], references: [id])
  code             String
  // TikTok-style warehouse id (a string) exposed as `id` by Get Warehouse List and as `warehouse_id` in SKU inventory. Unique per shop.
  externalId       String            @default("")
  name             String
  city             String
  isDefault        Boolean           @default(false)
  // Get Warehouse List `effect_status` (ENABLED | DISABLED | RESTRICTED per the OAS description).
  effectStatus     String            @default("ENABLED")
  inventory        InventoryLevel[]
  inventoryChanges InventoryChange[]
  createdAt        DateTime          @default(now())

  @@unique([shopId, code])
  @@unique([shopId, externalId])
}

model Product {
  id           String   @id @default(uuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id])
  // Marketplace product id (string). Unique PER SHOP only: the same id may exist in another shop and must never be confused.
  externalId   String
  title        String
  description  String   @default("")
  // OAS values: DRAFT PENDING FAILED ACTIVATE SELLER_DEACTIVATED PLATFORM_DEACTIVATED FREEZE DELETED. DELETED is a soft delete.
  status       String   @default("ACTIVATE")
  isNotForSale Boolean  @default(false)
  // Immutable, monotonic listing order. Backs the opaque page_token (keyset), so rows added during an import are never skipped or repeated.
  seq          Int      @unique @default(autoincrement())
  skus         Sku[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shopId, externalId])
  @@index([shopId, seq])
}

model Sku {
  id               String            @id @default(uuid())
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopId           String
  // Marketplace SKU id (string). Unique per shop, like Product.externalId.
  externalId       String
  // Seller SKU is a seller-managed code; the OAS states no uniqueness, so duplicates (also within a shop) are allowed.
  sellerSku        String
  name             String
  // Sales attribute shown for this variant (e.g. name "Màu", value = `name`).
  attributeName    String            @default("Phân loại")
  priceVnd         Int
  // OAS SKU status_info.status: NORMAL | DEACTIVATED.
  status           String            @default("NORMAL")
  inventory        InventoryLevel[]
  inventoryChanges InventoryChange[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  CartItem         CartItem[]

  @@unique([shopId, externalId])
  @@index([shopId, sellerSku])
  @@index([productId])
}

model InventoryLevel {
  id          String    @id @default(uuid())
  skuId       String
  sku         Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Int
  updatedAt   DateTime  @updatedAt

  @@unique([skuId, warehouseId])
}

model Scenario {
  id          String   @id @default(uuid())
  shopId      String
  shop        Shop     @relation("ShopScenarios", fields: [shopId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String   @default("")
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shopId, key])
}

// Isolation for demo (Seller/Buyer) calls. Only the SHA-256 of the session token is stored.
model DemoSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  role      DemoRole
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  buyerId   String?
  buyer     Buyer?   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([shopId])
}

// Every HTTP request handled by the simulator. Secrets/tokens are redacted BEFORE persistence.
model HttpRequestLog {
  id              String   @id @default(uuid())
  requestId       String
  router          String
  method          String
  path            String
  query           Json?
  requestHeaders  Json?
  requestBody     String?
  responseStatus  Int
  responseHeaders Json?
  responseBody    String?
  durationMs      Int
  shopId          String?
  createdAt       DateTime @default(now())

  @@index([requestId])
  @@index([createdAt])
  @@index([shopId, createdAt])
}

model WebhookJob {
  id             String           @id @default(uuid())
  shopId         String
  shop           Shop             @relation(fields: [shopId], references: [id])
  // When set, the body is signed with this app's secret (header Authorization = HMAC-SHA256(secret, app_key + raw body)).
  appId          String?
  app            App?             @relation(fields: [appId], references: [id])
  topic          String
  payload        Json
  targetUrl      String
  requestId      String?
  status         WebhookJobStatus @default(PENDING)
  attemptCount   Int              @default(0)
  maxAttempts    Int              @default(5)
  nextAttemptAt  DateTime         @default(now())
  leaseOwner     String?
  leaseToken     String?
  leaseExpiresAt DateTime?
  lastError      String?
  deliveredAt    DateTime?
  replayOfId     String?
  replayOf       WebhookJob?      @relation("Replay", fields: [replayOfId], references: [id])
  replays        WebhookJob[]     @relation("Replay")
  attempts       WebhookAttempt[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([shopId, createdAt])
  @@index([requestId])
}

model WebhookAttempt {
  id                String               @id @default(uuid())
  jobId             String
  job               WebhookJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attemptNo         Int
  workerId          String
  leaseToken        String
  status            WebhookAttemptStatus @default(STARTED)
  possibleDuplicate Boolean              @default(false)
  lateCompletion    Boolean              @default(false)
  deliveries        Int                  @default(1)
  startedAt         DateTime             @default(now())
  finishedAt        DateTime?
  httpStatus        Int?
  error             String?
  responseExcerpt   String?
  durationMs        Int?

  @@unique([jobId, attemptNo])
  @@index([jobId])
}

model FaultRule {
  id        String      @id @default(uuid())
  shopId    String?
  shop      Shop?       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  target    FaultTarget
  kind      FaultKind
  pathMatch String?
  params    Json        @default("{}")
  remaining Int?
  createdAt DateTime    @default(now())

  @@index([target, shopId])
}

// Singleton row (id = 1): business clock offset/freeze. Independent of the request-signature auth clock.
model ClockState {
  id        Int       @id
  offsetMs  BigInt    @default(0)
  frozenAt  DateTime?
  updatedAt DateTime  @updatedAt
}

// ---- Phase 05: cart, orders, webhook subscriptions -------------------------------------------------------------

model CartItem {
  id        String   @id @default(uuid())
  buyerId   String
  buyer     Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  skuId     String
  sku       Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  quantity  Int
  updatedAt DateTime @updatedAt

  @@unique([buyerId, skuId])
}

// Statuses are the OAS values: UNPAID ON_HOLD AWAITING_SHIPMENT PARTIALLY_SHIPPING AWAITING_COLLECTION IN_TRANSIT DELIVERED COMPLETED CANCELLED.
// Money is integer VND per component; totals are computed by the backend and never re-derived from each other.
model Order {
  id                    String             @id @default(uuid())
  shopId                String
  shop                  Shop               @relation(fields: [shopId], references: [id])
  externalId            String
  seq                   Int                @unique @default(autoincrement())
  buyerId               String
  buyer                 Buyer              @relation(fields: [buyerId], references: [id])
  status                String
  // business-clock timestamps (create_time / update_time / ... in the API are Unix seconds of these)
  createdAt             DateTime
  updatedAt             DateTime
  paidAt                DateTime?
  releaseAt             DateTime?
  rtsAt                 DateTime?
  collectionAt          DateTime?
  deliveredAt           DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancelReason          String?
  cancellationInitiator String?
  buyerRequestedCancel  Boolean            @default(false)
  isOnHold              Boolean            @default(false)
  warehouseId           String?
  stockReleased         Boolean            @default(false)
  checkoutKey           String
  paymentMethodName     String             @default("Fake payment (simulator)")
  buyerMessage          String             @default("")
  recipientName         String
  recipientPhone        String
  addressLine           String
  district              String
  city                  String
  postalCode            String             @default("")
  currency              String             @default("VND")
  originalProductPrice  Int
  sellerDiscount        Int                @default(0)
  platformDiscount      Int                @default(0)
  originalShippingFee   Int
  shippingFeeDiscount   Int                @default(0)
  tax                   Int                @default(0)
  lines                 OrderLine[]
  audits                OrderAudit[]
  Package               Package?
  TrackingEvent         TrackingEvent[]
  CouponUsage           CouponUsage[]
  aftersaleRequests     AftersaleRequest[]

  @@unique([shopId, externalId])
  @@unique([buyerId, checkoutKey])
  @@index([shopId, seq])
  @@index([shopId, updatedAt])
}

// One row per purchased unit: the OAS line item has no quantity field.
model OrderLine {
  id                String          @id @default(uuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  externalId        String
  skuId             String?
  skuExternalId     String
  productExternalId String
  productName       String
  skuName           String
  sellerSku         String
  originalPrice     Int
  salePrice         Int
  sellerDiscount    Int             @default(0)
  platformDiscount  Int             @default(0)
  packageId         String?
  displayStatus     String
  aftersaleLines    AftersaleLine[]

  @@index([orderId])
}

model OrderAudit {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  actor      String
  note       String   @default("")
  at         DateTime
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

// Events API subscription: one address per (shop, app, event_type).
model WebhookSubscription {
  id        String   @id @default(uuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  eventType String
  address   String
  createdAt DateTime
  updatedAt DateTime

  @@unique([shopId, appId, eventType])
}

// ---- Phase 06: inventory change log -----------------------------------------------------------------------------
// Every stock change (API absolute update, Seller edit, order reservation / cancel restore, admin) with before/after.
// The rows of one (sku, warehouse) form a chain in `seq` order: row[n].before == row[n-1].after. A broken chain would mean a lost update.
model InventoryChange {
  id          String    @id @default(uuid())
  seq         Int       @unique @default(autoincrement())
  shopId      String
  skuId       String
  sku         Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  before      Int
  after       Int
  // API | SELLER | ORDER | ADMIN
  source      String
  // true when an absolute update asked for the value already stored (a safe retry)
  noop        Boolean   @default(false)
  requestId   String?
  note        String    @default("")
  createdAt   DateTime  @default(now())

  @@index([shopId, seq])
  @@index([skuId, warehouseId, seq])
}

// One row per call to the inventory update API, including calls that never answered (timeout faults).
model InventoryUpdateAttempt {
  id           String   @id @default(uuid())
  seq          Int      @unique @default(autoincrement())
  shopId       String
  productId    String
  requestId    String?
  // APPLIED | PARTIAL | REJECTED | TIMEOUT_BEFORE_WRITE | TIMEOUT_AFTER_WRITE | APP_ERROR_200
  outcome      String
  itemsTotal   Int      @default(0)
  itemsApplied Int      @default(0)
  itemsFailed  Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([shopId, seq])
}

// ---- Phase 08: customer-service conversations ------------------------------------------------------------------

// One conversation between a TikTok buyer and the shop. `buyerId` is the simulator Buyer when the TikTok identity is KNOWN
// (orders can be linked through `buyerUserId` = Buyer.externalId); it is null for the identity-mismatch test scenario.
// `buyerUserId` (order-queryable id) and `buyerImUserId` (IM id, never usable to query orders) are deliberately different.
model Conversation {
  id                 String        @id @default(uuid())
  shopId             String
  shop               Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  externalId         String
  seq                Int           @unique @default(autoincrement())
  buyerId            String?
  buyer              Buyer?        @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerUserId        String
  buyerImUserId      String
  buyerNickname      String
  shopImUserId       String
  agentJoined        Boolean       @default(false)
  canSendMessage     Boolean       @default(true)
  // TEST DATA LABEL only (a seeded complaint-style conversation); never a classifier result and never returned by the TikTok API.
  complaintTestLabel Boolean       @default(false)
  // Test fault: the message IS stored but the response to the sender is dropped (an indeterminate send).
  dropSendResponse   Boolean       @default(false)
  createdAt          DateTime
  updatedAt          DateTime
  nextIndex          Int           @default(1)
  messages           ChatMessage[]

  @@unique([shopId, externalId])
  @@index([shopId, seq])
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  shopId         String
  externalId     String
  seq            Int          @unique @default(autoincrement())
  // per-conversation increasing index (string in the API)
  index          Int
  type           String       @default("TEXT")
  // JSON-serialized string exactly as the OAS requires, e.g. {"content":"hi"}
  content        String
  senderRole     String
  senderImUserId String
  senderNickname String
  isVisible      Boolean      @default(true)
  createdAt      DateTime

  @@unique([shopId, externalId])
  @@unique([conversationId, index])
  @@index([conversationId, seq])
}

// ---- Phase 07a: packages, tracking, shipping documents --------------------------------------------------------

// One package per order in this phase (splitting/combining is out of scope). package_status values follow the OAS:
// PROCESSING (arranged) FULFILLING (collected, in transit) COMPLETED (delivered) CANCELLED; TO_FULFILL (not yet arranged) is the
// OAS line-item package_status value, reused here because the package detail enum has no pre-arrangement value (unverified).
model Package {
  id                   String             @id @default(uuid())
  shopId               String
  shop                 Shop               @relation(fields: [shopId], references: [id])
  orderId              String             @unique
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  externalId           String
  status               String
  // Fake tracking number ("SIM" + 11 digits); null until the shipment is arranged.
  trackingNumber       String?
  shippingProviderId   String
  shippingProviderName String
  handoverMethod       String?
  createdAt            DateTime
  updatedAt            DateTime
  lines                PackageLine[]
  documents            ShippingDocument[]
  trackingEvents       TrackingEvent[]

  @@unique([shopId, externalId])
}

model PackageLine {
  id          String  @id @default(uuid())
  packageId   String
  package     Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  orderLineId String  @unique
}

model TrackingEvent {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packageId   String
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  status      String
  description String
  // business clock
  at          DateTime
  seq         Int      @default(autoincrement())

  @@index([orderId, at, seq])
}

// Generated PDF (TEST DATA). `token` is the unguessable public file name; the file lives under PDF_DIR.
model ShippingDocument {
  id        String   @id @default(uuid())
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  docType   String
  token     String   @unique
  filePath  String
  sizeBytes Int
  createdAt DateTime

  @@unique([packageId, docType])
}

// ---- Phase 09a: coupons (simulator-created fake data; reading is the only TikTok-shaped operation) --------------------

// Status in the API is DERIVED from deactivated + window + the business clock (NOT_START | ONGOING | EXPIRED | DEACTIVATED).
// Only FULL_SHOP scope and AMOUNT_OFF / PERCENT_OFF discounts exist; audience ALL | NEW (REPEAT_CUSTOMERS is not modelled).
model Coupon {
  id              String        @id @default(uuid())
  shopId          String
  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  externalId      String
  seq             Int           @unique @default(autoincrement())
  title           String
  promoCode       String
  displayType     String        @default("PROMO_CODE")
  discountType    String
  amountOffVnd    Int?
  percentage      Int?
  maxDiscountVnd  Int?
  minSpendVnd     Int?
  startAt         DateTime
  endAt           DateTime
  redemptionLimit Int?
  redeemedCount   Int           @default(0)
  audience        String        @default("ALL")
  deactivated     Boolean       @default(false)
  createdAt       DateTime
  updatedAt       DateTime
  usages          CouponUsage[]

  @@unique([shopId, externalId])
  @@unique([shopId, promoCode])
  @@index([shopId, seq])
}

// One row per (coupon, order): the unique constraint is what makes a retried checkout unable to count twice.
model CouponUsage {
  id          String   @id @default(uuid())
  couponId    String
  coupon      Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountVnd Int
  createdAt   DateTime

  @@unique([couponId, orderId])
}

// ---- Phase 07b: cancellations and returns/refunds (aftersale) ---------------------------------------------------
// One table for both kinds. Statuses are the OAS values:
//   CANCELLATION: CANCELLATION_REQUEST_PENDING | _SUCCESS | _CANCELLED | _COMPLETE
//   RETURN:       RETURN_OR_REFUND_REQUEST_PENDING | AWAITING_BUYER_SHIP | BUYER_SHIPPED_ITEM | REJECT_RECEIVE_PACKAGE |
//                 REFUND_OR_RETURN_REQUEST_REJECT | RETURN_OR_REFUND_REQUEST_SUCCESS | _CANCEL | _COMPLETE
// The order status is NEVER changed by a return (the OAS order statuses have no RETURNED value).
model AftersaleRequest {
  id                   String            @id @default(uuid())
  shopId               String
  shop                 Shop              @relation(fields: [shopId], references: [id])
  orderId              String
  order                Order             @relation(fields: [orderId], references: [id])
  externalId           String
  seq                  Int               @unique @default(autoincrement())
  // CANCELLATION | RETURN
  kind                 String
  // cancel_type CANCEL | BUYER_CANCEL, or return_type REFUND | RETURN_AND_REFUND
  type                 String
  status               String
  reason               String
  // BUYER | SELLER | SYSTEM
  role                 String
  rejectReason         String?
  rejectComment        String?
  returnTrackingNumber String?
  arbitrationStatus    String            @default("NO_ARBITRATION")
  sellerProposedReturnType String?
  currency             String            @default("VND")
  refundSubtotal       Int
  refundShipping       Int               @default(0)
  refundTotal          Int
  createdAt            DateTime
  updatedAt            DateTime
  lines                AftersaleLine[]
  records              AftersaleRecord[]

  @@unique([shopId, externalId])
  @@index([shopId, seq])
  @@index([orderId])
}

// One row per purchased UNIT (OrderLine is per unit). `active` is true while the unit is held by a live or successful request;
// a partial unique index (see the migration) allows at most ONE active row per order line, so a unit can never be refunded twice.
model AftersaleLine {
  id             String           @id @default(uuid())
  requestId      String
  request        AftersaleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  orderLineId    String
  orderLine      OrderLine        @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  externalId     String
  refundSubtotal Int
  active         Boolean          @default(true)

  @@index([requestId])
  @@index([orderLineId])
}

model AftersaleRecord {
  id             String           @id @default(uuid())
  requestId      String
  request        AftersaleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus     String?
  toStatus       String
  // BUYER | SELLER | SYSTEM | OPERATOR (test console)
  actor          String
  note           String           @default("")
  idempotencyKey String?
  at             DateTime
  createdAt      DateTime         @default(now())

  @@unique([requestId, idempotencyKey])
  @@index([requestId, createdAt])
}
